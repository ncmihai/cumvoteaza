DATABASE_URL=postgres://postgres:postgres@localhost:5432/cumsevoteaza
DATABASE_MAX_CONNECTIONS=3
CUMSEVOTEAZA_SITE_PASSWORD=
CRON_SECRET=
DATA_HEALTH_REVIEW_TOKEN=
ANALYTICS_SALT=
CUMSEVOTEAZA_PERF_LOG=

# Asset import storage. Digi Storage is preferred for binary assets; Vercel Blob is legacy fallback.
ASSET_STORAGE_PROVIDER=vercel_blob
BLOB_READ_WRITE_TOKEN=
DIGI_STORAGE_EMAIL=
DIGI_STORAGE_PASSWORD=
DIGI_STORAGE_MOUNT_ID=
DIGI_STORAGE_BASE_PATH=cumvoteaza-assets
DIGI_STORAGE_BASE_URL=https://storage.rcs-rds.ro
DIGI_STORAGE_API_URL=https://storage.rcs-rds.ro/api/v2.1
ASSET_FTP_HOST=
ASSET_FTP_PORT=21
ASSET_FTP_SECURE=true
ASSET_FTP_USERNAME=
ASSET_FTP_PASSWORD=
ASSET_FTP_BASE_PATH=cumvoteaza-assets
ASSET_FTP_PUBLIC_BASE_URL=
ASSET_FTP_TIMEOUT_MS=60000
